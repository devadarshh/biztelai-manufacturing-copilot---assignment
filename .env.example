# Frontend
NODE_ENV=development
AUTH_SECRET=
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=
DIRECT_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000
SKIP_ENV_VALIDATION=1

# AI / embeddings. Local model inference avoids hosted Hugging Face API credits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
HUGGINGFACE_API_KEY=
HF_EMBEDDING_PROVIDER=local
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBEDDING_DIMENSION=384

# Supabase Storage for PDFs (private service-role key; backend only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=files
SUPABASE_CACHE_PATH=./storage/supabase_cache
DOCUMENT_STORAGE_MODE=auto
DOCUMENT_UPLOAD_PATH=./storage/uploads
DOCUMENT_EXCLUDE_FILES=

# Qdrant: use auto to select cloud from QDRANT_URL or force local/cloud
QDRANT_MODE=auto
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./storage/qdrant_db
QDRANT_COLLECTION_NAME=manufacturing_documents
DOCUMENT_STORAGE_PATH=./storage/documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
RETRIEVAL_THRESHOLD=
INGESTION_MODE=auto
INGESTION_QUEUE_NAME=document-ingestion
INGESTION_JOB_TIMEOUT_SECONDS=900
MAX_UPLOAD_SIZE_MB=50
REDIS_URL=
CORS_ORIGINS=http://localhost:5174
APP_HOST=0.0.0.0
APP_PORT=8001
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
